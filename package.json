{
  "name": "fahrenheit-converter-service",
  "version": "1.0.0",
  "description": "Node.js TypeScript Express webservice for temperature conversion.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "build:client": "vite build",
    "dev": "tsx watch src/server/index.ts",
    "serve:api": "tsx src/server/index.ts",
    "dev:client": "vite --host 127.0.0.1",
    "start": "node dist/server/index.js",
    "test": "jest --verbose && vitest run && playwright test",    
    "test:server": "jest --verbose",
    "test:client": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "express": "^5.1.0",
    "swagger-ui-express": "^5.0.1",
    "vue": "^3.5.40"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.4",
    "@types/supertest": "^7.2.0",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.1",
    "jest": "^30.4.2",
    "jsdom": "^31.0.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.0"
  }
}
